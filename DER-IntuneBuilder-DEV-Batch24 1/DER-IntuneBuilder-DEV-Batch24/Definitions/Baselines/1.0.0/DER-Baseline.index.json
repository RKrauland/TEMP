  "metadata": {
    "count": 73,
    "source": "Core/DER.Planner.psm1 literal DER IDs; runtime-generated DER-ID families are explicitly modeled in dynamicDerIdPatterns.",
    "dynamicDerIdPatterns": [
      {
        "id": "DepartmentUserGroups",
        "pattern": "^DER-GRP-U-[0-9]+0$",
        "constraints": {
          "start": 200,
          "increment": 10
        },
        "module": "Groups",
        "objectType": "SecurityGroup",
        "source": "Core/DER.Planner.psm1:Add-DERGroupObjects",
        "sourceExpression": "DER-GRP-U-{0}",
        "notes": "Department group IDs start at 200 and increase by 10 for each questionnaire department."
      },
      {
        "id": "SiteNamedLocations",
        "pattern": "^DER-LOC-SITE-[0-9]{3}$",
        "constraints": {
          "format": "000",
          "sourceIndex": "Answers.Infrastructure.Sites[].Index"
        },
        "module": "NamedLocations",
        "objectType": "NamedLocation",
        "source": "Core/DER.Planner.psm1:Add-DERWorkloadObjects",
        "sourceExpression": "DER-LOC-SITE-{0:000}",
        "notes": "One DER ID is generated for each site explicitly selected to create a named location."
      }
    ]
  }
}
