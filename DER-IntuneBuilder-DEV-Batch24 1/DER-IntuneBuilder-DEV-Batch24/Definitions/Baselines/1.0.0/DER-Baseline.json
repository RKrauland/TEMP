    },
    {
      "name": "Compliance",
      "enabledByDefault": true,
      "risk": "Low"
    },
    {
      "name": "BitLocker",
      "enabledByDefault": true,
      "risk": "Low"
    },
    {
      "name": "LAPS",
      "enabledByDefault": true,
      "risk": "Low"
    },
    {
      "name": "Defender",
      "enabledByDefault": true,
      "risk": "Low"
    },
    {
      "name": "ASR",
      "enabledByDefault": true,
      "risk": "Low"
    },
    {
      "name": "Firewall",
      "enabledByDefault": true,
      "risk": "Low"
    },
    {
      "name": "Configuration",
