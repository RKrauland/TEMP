{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.example.invalid/schema/DER-DevFreezePolicy.schema.json",
  "title": "DER Development Freeze Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedForPackage",
    "generatedForBuild",
    "lifecycleStatus",
    "purpose",
    "featureFreeze",
    "packageIdentity",
    "requiredGates",
    "productionRelease"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "policyVersion": {
      "const": "1.0.0"
    },
    "generatedForPackage": {
      "type": "string",
      "minLength": 1
    },
    "generatedForBuild": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycleStatus": {
      "const": "FeatureCompleteDevelopment"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "featureFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newTenantFeaturesAllowed",
        "workloadDefinitionsFrozen",
        "baselineVersion",
        "allowedPostFreezeChanges",
        "policy"
      ],
      "properties": {
        "newTenantFeaturesAllowed": {
          "const": false
        },
        "workloadDefinitionsFrozen": {
          "const": true
        },
        "baselineVersion": {
          "const": "1.0.0"
        },
        "allowedPostFreezeChanges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DefectFix",
              "TestFix",
              "DocumentationCorrection",
              "CompatibilityCorrection",
              "SecurityFix"
            ]
          }
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineVersion",
        "buildNumber",
        "coreModules",
        "workloadModules",
        "parentModules"
      ],
      "properties": {
        "engineVersion": {
          "const": "1.0.0-dev"
        },
        "buildNumber": {
          "type": "integer",
          "minimum": 1
        },
        "coreModules": {
          "const": 19
        },
        "workloadModules": {
          "const": 25
        },
        "parentModules": {
          "const": 44
        }
      }
    },
    "requiredGates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "id",
          "command",
          "evidence",
          "requiredResult",
          "tenantMutationAllowed"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "id": {
            "enum": [
              "WindowsSmoke",
              "TenantNoWrite",
              "TenantCanary",
              "TenantPilot"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "requiredResult": {
            "const": "PASS"
          },
          "tenantMutationAllowed": {
            "type": "boolean"
          }
        }
      }
    },
    "productionRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "reason",
        "signedReleaseRequired",
        "realCustomerTenantWriteAllowedBeforeGatesPass"
      ],
      "properties": {
        "ready": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "signedReleaseRequired": {
          "const": true
        },
        "realCustomerTenantWriteAllowedBeforeGatesPass": {
          "const": false
        }
      }
    }
  }
}
