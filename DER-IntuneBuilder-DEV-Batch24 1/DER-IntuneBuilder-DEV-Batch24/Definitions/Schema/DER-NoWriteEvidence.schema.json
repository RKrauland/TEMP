{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.example.invalid/schema/DER-NoWriteEvidence.schema.json",
  "title": "DER Test-Tenant No-Write Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "policyVersion",
    "packageVersion",
    "buildNumber",
    "runId",
    "tenantId",
    "startedAt",
    "completedAt",
    "passed",
    "failedChecks",
    "workflow",
    "prohibitedStages",
    "operatorAttestation",
    "dryRun",
    "graphAudit",
    "graphForensic",
    "authentication",
    "permissions",
    "sourceSafety",
    "transactionSafety",
    "checks",
    "supportingArtifacts",
    "supportingHashes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "evidenceType": {
      "const": "DER-TestTenant-NoWrite"
    },
    "policyVersion": {
      "const": "1.0.0"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "buildNumber": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "tenantName": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "passed": {
      "type": "boolean"
    },
    "failedChecks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "pattern": "^INT-[0-9]{3}$"
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibitedStages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "dryRun": {
      "type": "object",
      "required": [
        "readyToBuild",
        "blockingFailures",
        "warnings",
        "integrationNoWrite",
        "finalApprovalGranted"
      ],
      "properties": {
        "readyToBuild": {
          "type": "boolean"
        },
        "blockingFailures": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "integrationNoWrite": {
          "const": true
        },
        "finalApprovalGranted": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "graphAudit": {
      "type": "object"
    },
    "graphForensic": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "transportEventCount",
        "mutationTransportEventCount",
        "blockedWriteEventCount",
        "parseErrorCount"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "transportEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "mutationTransportEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockedWriteEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "parseErrorCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object"
    },
    "permissions": {
      "type": "object"
    },
    "sourceSafety": {
      "type": "object"
    },
    "transactionSafety": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object"
      }
    },
    "supportingHashes": {
      "type": "object",
      "required": [
        "packageManifestSHA256",
        "graphLogSHA256",
        "technicalLogSHA256"
      ],
      "properties": {
        "packageManifestSHA256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "graphLogSHA256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "technicalLogSHA256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "operatorAttestation": {
      "type": [
        "object",
        "null"
      ]
    },
    "supportingArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphLogSnapshot",
        "technicalLogSnapshot"
      ],
      "properties": {
        "graphLogSnapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "technicalLogSnapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
