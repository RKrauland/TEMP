{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.example.invalid/schema/DER-PackageManifest.schema.json",
  "title": "DER Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "buildNumber",
    "channel",
    "engineVersion",
    "baselineVersion",
    "generatedUtc",
    "hashAlgorithm",
    "trustAnchor",
    "protectedFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "buildNumber": {
      "type": "integer",
      "minimum": 1
    },
    "channel": {
      "enum": [
        "Development",
        "Release"
      ]
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "baselineVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "hashAlgorithm": {
      "const": "SHA256"
    },
    "trustAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "manifestHashConstant",
        "design"
      ],
      "properties": {
        "relativePath": {
          "const": "Start-DERIntuneBuilder.ps1"
        },
        "manifestHashConstant": {
          "const": "DERPackageManifestSHA256"
        },
        "design": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protectedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\].*"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "Core",
              "Workload",
              "Definition",
              "Schema",
              "Template",
              "Test",
              "Tool",
              "Documentation",
              "Metadata",
              "Other"
            ]
          }
        }
      }
    }
  }
}
