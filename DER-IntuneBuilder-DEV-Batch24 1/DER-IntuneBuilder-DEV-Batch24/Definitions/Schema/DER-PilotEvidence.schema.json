{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.example.invalid/schema/DER-PilotEvidence.schema.json",
  "title": "DER End-to-End Workload Pilot Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "policyVersion",
    "packageVersion",
    "buildNumber",
    "runId",
    "tenantId",
    "completedAt",
    "passed",
    "failures",
    "cleanupComplete",
    "prerequisites",
    "operatorApproval",
    "workload",
    "stateLifecycle",
    "controlledObject",
    "graphDelta",
    "authenticationDelta",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "evidenceType": {
      "const": "DER-Workload-Pilot"
    },
    "policyVersion": {
      "const": "1.0.0"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "buildNumber": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "tenantName": {
      "type": [
        "string",
        "null"
      ]
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cleanupComplete": {
      "type": "boolean"
    },
    "prerequisites": {
      "type": "object"
    },
    "operatorApproval": {
      "type": "object"
    },
    "workload": {
      "type": "object",
      "required": [
        "module",
        "entryPoint",
        "derId",
        "displayName",
        "objectId",
        "workloadStatus",
        "rollbackStatus"
      ],
      "properties": {
        "module": {
          "const": "Groups"
        },
        "entryPoint": {
          "const": "Invoke-DERGroupsModule"
        },
        "derId": {
          "const": "DER-PILOT-GRP-001"
        },
        "displayName": {
          "type": "string"
        },
        "objectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workloadStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollbackStatus": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "stateLifecycle": {
      "type": "object",
      "required": [
        "created",
        "removedAfterRollback"
      ],
      "properties": {
        "created": {
          "type": "boolean"
        },
        "removedAfterRollback": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "controlledObject": {
      "type": "object",
      "required": [
        "derId",
        "objectId",
        "displayName",
        "objectType",
        "ownershipClass",
        "activeObjectRemaining",
        "deletedObjectRemaining"
      ],
      "properties": {
        "derId": {
          "const": "DER-PILOT-GRP-001"
        },
        "objectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "objectType": {
          "const": "microsoft.graph.group"
        },
        "ownershipClass": {
          "const": "DER-Owned"
        },
        "activeObjectRemaining": {
          "type": "boolean"
        },
        "deletedObjectRemaining": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "graphDelta": {
      "type": "object",
      "required": [
        "transportWrites",
        "post",
        "patch",
        "put",
        "delete"
      ],
      "properties": {
        "requestAttempts": {
          "type": "integer"
        },
        "transportRequests": {
          "type": "integer"
        },
        "transportReads": {
          "type": "integer"
        },
        "transportWrites": {
          "type": "integer"
        },
        "blockedWrites": {
          "type": "integer"
        },
        "post": {
          "type": "integer"
        },
        "patch": {
          "type": "integer"
        },
        "put": {
          "type": "integer"
        },
        "delete": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "authenticationDelta": {
      "type": "object",
      "required": [
        "writeSessionAttempts",
        "writeSessionsOpened"
      ],
      "properties": {
        "writeSessionAttempts": {
          "type": "integer"
        },
        "writeSessionsOpened": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
