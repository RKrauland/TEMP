{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.example.invalid/schema/DER-PilotPolicy.schema.json",
  "title": "DER Workload Pilot Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedForPackage",
    "generatedForBuild",
    "purpose",
    "prerequisites",
    "operator",
    "workload",
    "graph",
    "rollback",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "policyVersion": {
      "const": "1.0.0"
    },
    "generatedForPackage": {
      "type": "string",
      "minLength": 1
    },
    "generatedForBuild": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "object"
    },
    "operator": {
      "type": "object",
      "required": [
        "confirmationToken",
        "requiredRoles",
        "recommendation"
      ],
      "properties": {
        "confirmationToken": {
          "const": "PILOT-WRITE"
        },
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": [
        "module",
        "entryPoint",
        "rollbackEntryPoint",
        "derId",
        "objectType",
        "displayNamePrefix",
        "membership",
        "principalType",
        "existingObjectMutationAllowed",
        "membersAllowed",
        "assignmentsAllowed",
        "dynamicMembershipAllowed",
        "roleAssignableAllowed"
      ],
      "properties": {
        "module": {
          "const": "Groups"
        },
        "entryPoint": {
          "const": "Invoke-DERGroupsModule"
        },
        "rollbackEntryPoint": {
          "const": "Invoke-DERModuleRollback"
        },
        "derId": {
          "const": "DER-PILOT-GRP-001"
        },
        "objectType": {
          "const": "SecurityGroup"
        },
        "displayNamePrefix": {
          "type": "string",
          "minLength": 1
        },
        "membership": {
          "const": "Assigned"
        },
        "principalType": {
          "const": "Device"
        },
        "existingObjectMutationAllowed": {
          "const": false
        },
        "membersAllowed": {
          "const": false
        },
        "assignmentsAllowed": {
          "const": false
        },
        "dynamicMembershipAllowed": {
          "const": false
        },
        "roleAssignableAllowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": [
        "apiVersion",
        "requiredDelegatedScopes",
        "controlledObjectCount",
        "expectedMutationDelta",
        "expectedWorkloadCreateCount",
        "expectedRollbackDeleteCount",
        "expectedPermanentPurgeCount"
      ],
      "properties": {
        "apiVersion": {
          "const": "v1.0"
        },
        "requiredDelegatedScopes": {
          "type": "array",
          "contains": {
            "const": "Group.ReadWrite.All"
          }
        },
        "controlledObjectCount": {
          "const": 1
        },
        "expectedMutationDelta": {
          "type": "object",
          "required": [
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ],
          "properties": {
            "POST": {
              "const": 1
            },
            "PATCH": {
              "const": 0
            },
            "PUT": {
              "const": 0
            },
            "DELETE": {
              "const": 2
            }
          },
          "additionalProperties": false
        },
        "expectedWorkloadCreateCount": {
          "const": 1
        },
        "expectedRollbackDeleteCount": {
          "const": 1
        },
        "expectedPermanentPurgeCount": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    }
  }
}
