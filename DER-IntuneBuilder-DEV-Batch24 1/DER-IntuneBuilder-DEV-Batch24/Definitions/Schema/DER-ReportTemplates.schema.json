{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.local/schemas/DER-ReportTemplates.schema.json",
  "title": "DER Report Templates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateVersion",
    "generatedForBaseline",
    "manualAction",
    "productionActivationChecklist",
    "engineerHandoff"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "templateVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedForBaseline": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "manualAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultStatus", "closeRule", "ownerField", "notesField", "completedAtField"],
      "properties": {
        "defaultStatus": { "const": "Open" },
        "closeRule": { "type": "string", "minLength": 1 },
        "ownerField": { "type": "boolean" },
        "notesField": { "type": "boolean" },
        "completedAtField": { "type": "boolean" }
      }
    },
    "productionActivationChecklist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "engineerHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closeRule"],
      "properties": { "closeRule": { "type": "string", "minLength": 1 } }
    }
  }
}
