{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.example.invalid/schema/DER-SigningPolicy.schema.json",
  "title": "DER Code Signing Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "development",
    "release",
    "signablePaths",
    "releaseProcedure"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "policyVersion": {
      "type": "string"
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsignedAllowed",
        "failOnInvalidSignature"
      ],
      "properties": {
        "unsignedAllowed": {
          "const": true
        },
        "failOnInvalidSignature": {
          "const": true
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticodeRequired",
        "publisherTrustMode",
        "allowedCertificateThumbprints",
        "blockIfThumbprintListEmpty",
        "timestampRequired"
      ],
      "properties": {
        "authenticodeRequired": {
          "const": true
        },
        "publisherTrustMode": {
          "const": "ExplicitThumbprint"
        },
        "allowedCertificateThumbprints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{40,64}$"
          },
          "uniqueItems": true
        },
        "blockIfThumbprintListEmpty": {
          "const": true
        },
        "timestampRequired": {
          "const": true
        }
      }
    },
    "signablePaths": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "releaseProcedure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
