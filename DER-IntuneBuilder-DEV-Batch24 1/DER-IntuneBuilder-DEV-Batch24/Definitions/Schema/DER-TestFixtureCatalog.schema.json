{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://der.invalid/schema/DER-TestFixtureCatalog.schema.json",
  "title": "DER Graph Test Fixture Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generatedForBaseline",
    "sanitized",
    "workloads",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedForBaseline": {
      "type": "string"
    },
    "sanitized": {
      "const": true
    },
    "syntheticIdNamespace": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "workloads": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "moduleFile",
          "graphMode",
          "coverageMode",
          "interactions"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "moduleFile": {
            "type": "string",
            "pattern": "^Workloads/DER\\..+\\.psm1$"
          },
          "graphMode": {
            "enum": [
              "Automatic",
              "ManualOnly"
            ]
          },
          "coverageMode": {
            "enum": [
              "mocked-flow",
              "pure+mock-contract",
              "manual-only"
            ]
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "apiVersion",
                "routePattern"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "apiVersion": {
                  "enum": [
                    "v1.0",
                    "beta"
                  ]
                },
                "routePattern": {
                  "type": "string",
                  "minLength": 1
                },
                "responseFixture": {
                  "type": "string",
                  "pattern": "^Graph/.+\\.json$"
                }
              }
            }
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "format",
          "sanitized"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^Graph/.+\\.json$"
          },
          "format": {
            "const": "MicrosoftGraphLikeJson"
          },
          "sanitized": {
            "const": true
          }
        }
      }
    }
  }
}
